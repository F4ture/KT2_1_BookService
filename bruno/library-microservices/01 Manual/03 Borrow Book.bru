meta {
  name: Borrow Book
  type: http
  seq: 3
}

post {
  url: {{borrowUrl}}/borrows
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "bookId": {{bookId}},
    "userId": {{userId}}
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) bru.setVar("borrowId", body.id);
}

tests {
  test("Книга выдана", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("BORROWED");
  });
}
