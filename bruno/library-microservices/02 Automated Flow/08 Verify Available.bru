meta {
  name: Verify Book Available
  type: http
  seq: 8
}

get {
  url: {{bookUrl}}/books/{{bookId}}
  body: none
  auth: none
}

tests {
  test("После возврата книга снова доступна", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().available).to.equal(true);
  });
}
