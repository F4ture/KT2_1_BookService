meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{userUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Integration Tester",
    "email": "integration.{{runId}}@example.com"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.id) bru.setVar("userId", body.id);
}

tests {
  test("Пользователь создан", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("number");
    expect(res.getBody().email).to.contain("integration.");
  });
}
