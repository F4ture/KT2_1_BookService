meta {
  name: Verify Book Unavailable
  type: http
  seq: 5
}

get {
  url: {{bookUrl}}/books/{{bookId}}
  body: none
  auth: none
}

tests {
  test("После выдачи книга недоступна", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().available).to.equal(false);
  });
}
