meta {
  name: Reject Duplicate Borrow
  type: http
  seq: 6
}

post {
  url: {{borrowUrl}}/borrows
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "bookId": {{bookId}},
    "userId": {{userId}}
  }
}

tests {
  test("Повторная выдача отклонена", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
